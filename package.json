{
  "name": "@tomsmart-ai/x402-saas-starter",
  "version": "0.1.0",
  "description": "Ship your first x402-monetized API in under 60 minutes. Battle-tested middleware (CDP + EIP-3009), Stripe fallback, Postgres schema, Solana wallet auth.",
  "license": "MIT",
  "author": {
    "name": "Tom Smart",
    "url": "https://smartflowproai.com"
  },
  "homepage": "https://github.com/smartflowproai-lang/x402-saas-starter",
  "repository": {
    "type": "git",
    "url": "https://github.com/smartflowproai-lang/x402-saas-starter.git"
  },
  "keywords": [
    "x402",
    "saas",
    "boilerplate",
    "starter",
    "cdp",
    "coinbase",
    "stripe",
    "solana",
    "phantom",
    "next.js",
    "usdc",
    "micropayments",
    "agent-economy"
  ],
  "type": "module",
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint || true",
    "format": "prettier --write \"src/**/*.{ts,tsx,json,md}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "next": "^14.2.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "drizzle-orm": "^0.33.0",
    "postgres": "^3.4.4",
    "stripe": "^16.8.0",
    "@solana/web3.js": "^1.95.3",
    "@solana/wallet-adapter-base": "^0.9.23",
    "@solana/wallet-adapter-react": "^0.15.35",
    "@solana/wallet-adapter-phantom": "^0.9.24",
    "@solana/wallet-adapter-react-ui": "^0.9.35",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "drizzle-kit": "^0.24.2",
    "prettier": "^3.3.3",
    "typescript": "^5.5.3",
    "vitest": "^2.0.5"
  }
}
